import random

pronouns_data = {
    "личные": ["я", "ты", "он", "она", "оно", "мы", "вы", "они", "меня", "тебя", "его", "ее", "нас", "вас", "их"],
    "возвратное": ["себя"],
    "притяжательные": ["мой", "твой", "ваш", "наш", "свой", "его", "ее", "их"],
    "указательные": ["тот", "этот", "такой", "таков", "столько"],
    "определительные": ["сам", "самый", "весь", "всякий", "каждый", "любой", "иной", "другой"],
    "вопросительные": ["кто?", "что?", "какой?", "чей?", "сколько?", "каков?", "который?"],
    "относительные": ["кто", "что", "какой", "чей", "сколько", "каков", "который"],
    "отрицательные": ["никто", "ничто", "некого", "нечего", "никакой", "ничей"],
    "неопределенные": ["некто", "нечто", "некоторый", "несколько", "кто-то", "что-нибудь", "кое-кто"]
}

def study_pronouns():
    # Создаем плоский список для перемешивания: (слово, разряд)
    cards = [(word, category) for category, words in pronouns_data.items() for word in words]
    random.shuffle(cards)

    print("--- ТРЕНАЖЕР: РАЗРЯДЫ МЕСТОИМЕНИЙ ---")
    print("Вводи название разряда (например: личные, притяжательные, указательные)")
    
    score = 0
    for word, category in cards[:20]: # Проверка на 20 случайных слов
        answer = input(f"Разряд местоимения '{word}': ").lower().strip()
        if answer == category:
            print("✅ Правильно!")
            score += 1
        else:
            print(f"❌ Нет, это: {category}")
    
    print(f"\nИтог: {score} из 20")

if __name__ == "__main__":
    study_pronouns()
