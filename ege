def run_trainer():
    words = list(words_db.keys())
    random.shuffle(words)
    
    score = 0
    wrong_answers = []

    print("=== ТРЕНАЖЕР УДАРЕНИЙ ЕГЭ ===")
    print("Правила: вводи слово целиком, выделяя ударную гласную БОЛЬШОЙ буквой.")
    print("Пример: звонит -> звонИт. Для выхода напиши 'exit'.\n")

    for word in words:
        user_input = input(f"Как правильно: {word}? ").strip()
        
        if user_input.lower() == 'exit':
            break
            
        if user_input == words_db[word]:
            print("✅ Верно!")
            score += 1
        else:
            print(f"❌ Ошибка. Правильно: {words_db[word]}")
            wrong_answers.append(words_db[word])
    
    print(f"\n--- ТРЕНИРОВКА ОКОНЧЕНА ---")
    print(f"Твой результат: {score} из {len(words)}")
    
    if wrong_answers:
        print("\nОбрати внимание на эти слова:")
        print(", ".join(wrong_answers))

if __name__ == "__main__":
    run_trainer()
