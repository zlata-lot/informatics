import random

data = {
    "Частицы": {
        "усилительная": ["даже", "ведь", "же", "уж", "уже", "и", "-то", "-таки", "всё-таки"],
        "выделительно-ограничительная": ["только", "лишь", "лишь только", "всего", "просто", "исключительно", "единственно"],
        "вопросительная": ["разве", "неужели", "ли", "ль"],
        "восклицательная": ["что за", "как", "какой", "ну и", "прямо"],
        "уточняющая/формообразующая": ["именно", "как раз", "бы", "было", "давай"]
    },
    "Союзы": {
        "соединительный сочинительный": ["и", "да (=и)", "не только — но и", "как — так и", "ни — ни", "тоже", "также"],
        "противительный сочинительный": ["но", "а", "да (=но, а)", "зато", "однако"],
        "разделительный сочинительный": ["или", "либо", "то — то", "не то — не то"],
        "причинный подчинительный": ["потому что", "так как", "поскольку", "ибо"],
        "целевой подчинительный": ["чтобы", "для того чтобы"],
        "временной подчинительный": ["когда", "как только", "пока"],
        "условный/уступительный подчинительный": ["если", "хотя", "несмотря на то что"],
        "изъяснительный подчинительный": ["что", "чтобы", "будто"]
    }
}

def run_quiz(mode):
    category_data = data["Частицы"] if mode == "1" else data["Союзы"]
    cards = [(word, group) for group, words in category_data.items() for word in words]
    random.shuffle(cards)

    print(f"\n--- ТРЕНИРОВКА: {'ЧАСТИЦЫ' if mode == '1' else 'СОЮЗЫ'} ---")
    print("Вводи разряд (например: 'усилительная' или 'противительный сочинительный')")
    print("Для выхода в меню введи 'back'\n")

    correct = 0
    for word, group in cards:
        user_ans = input(f"Разряд для '{word.upper()}': ").lower().strip()
        
        if user_ans == "back": break
        
        if user_ans == group:
            print("✅ Правильно!")
            correct += 1
        else:
            print(f"❌ Ошибка. Это: {group}")

    print(f"\nРезультат: {correct} из {len(cards)}")

def main():
    while True:
        print("\n=== ТРЕНАЖЕР: СОЮЗЫ И ЧАСТИЦЫ")
        print("1. Разряды частиц")
        print("2. Разряды союзов")
        print("0. Выход")
        
        choice = input("\nВыбери режим: ")
        
        if choice == "1" or choice == "2":
            run_quiz(choice)
        elif choice == "0":
            print("Удачи на экзамене!")
            break
        else:
            print("Неверный ввод, попробуй еще раз.")

if __name__ == "__main__":
    main()
